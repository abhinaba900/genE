# ─────────────────────────────────────────────────────────────
# Gen E — environment. Copy to .env.local (never commit real values).
# ─────────────────────────────────────────────────────────────

# Public origin of the site. Used for canonical URLs, sitemap, Open Graph, CMS previews and CSRF/CORS.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL.
# Production: Supabase → Connect → "Session pooler" (port 5432) for a long-running server,
# or "Transaction pooler" (port 6543) for serverless. Percent-encode special characters in the password.
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:5432/postgres
# Development: `npm run db:start` runs a local cluster on port 5433:
DATABASE_URL=postgres://postgres@127.0.0.1:5433/gen_e
# Connections per server instance (default 5 for remote, 10 for local). Keep the total
# across all instances under your Supabase pooler limit.
DATABASE_POOL_MAX=
# Optional: Supabase's CA certificate (Database → Settings → SSL), PEM on one line with
# literal \n line breaks, to verify the server certificate. Without it, the connection is still encrypted.
DATABASE_CA_CERT=

# Long random string used to sign CMS sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
PAYLOAD_SECRET=

# ── Media storage (Bunny Storage via its S3-compatible API) ──
# Leave the access key empty to store uploads on local disk (development only).
# Access key ID = storage zone name; secret = the zone's (read/write) password.
BUNNY_STORAGE_ZONE_NAME=
BUNNY_STORAGE_ACCESS_KEY=
BUNNY_STORAGE_ENDPOINT=https://sg-s3.storage.bunnycdn.com
BUNNY_STORAGE_REGION=sg
# Pull zone (CDN) connected to the storage zone — the public origin of every media URL.
BUNNY_CDN_URL=https://your-zone.b-cdn.net
# Upload size limits in MB.
VIDEO_MAX_MB=1024
IMAGE_MAX_MB=20

# ── Scheduled publishing ──
# Long-running servers run the scheduler in-process (default). On serverless hosts set
# JOBS_AUTORUN=false and call GET /api/payload-jobs/run?queue=editorial every minute with
#   Authorization: Bearer $CRON_SECRET
JOBS_AUTORUN=true
CRON_SECRET=

# Time zone editors schedule and read dates in.
EDITORIAL_TIMEZONE=Asia/Kolkata

# First-party analytics (no cookies, no IPs). Set to false to stop collecting.
ANALYTICS_ENABLED=true

# ── Email (password reset). Without SMTP, emails are printed to the server log. ──
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=cms@your-domain

# ── Optional: accounts created by `npm run seed` (development/testing only) ──
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=
SEED_AUTHOR_EMAIL=
SEED_AUTHOR_PASSWORD=
